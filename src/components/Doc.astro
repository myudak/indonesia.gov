---
// Abstract document illustration used in hero scenes (ID card, passport, form, receipt).
interface Props {
  type: 'card' | 'book' | 'form' | 'receipt';
  accent: string;
  label: string;
}
const { type, accent, label } = Astro.props;
---

{
  type === 'card' && (
    <svg viewBox="0 0 260 168" class="w-full drop-shadow-[0_30px_40px_rgba(0,0,0,0.18)]" aria-hidden="true">
      <rect width="260" height="168" rx="16" fill="#fff" />
      <rect width="260" height="38" rx="16" fill={accent} />
      <rect y="22" width="260" height="16" fill={accent} />
      <text x="18" y="25" fill="#fff" font-family="Plus Jakarta Sans Variable, sans-serif" font-size="12" font-weight="700" letter-spacing="1.5">
        {label.toUpperCase()}
      </text>
      <rect x="18" y="54" width="62" height="78" rx="8" fill={accent} opacity=".14" />
      <circle cx="49" cy="84" r="14" fill={accent} opacity=".35" />
      <path d="M27 128c4-16 14-22 22-22s18 6 22 22" fill={accent} opacity=".35" />
      <rect x="96" y="58" width="120" height="9" rx="4.5" fill="#15171b" opacity=".75" />
      <rect x="96" y="78" width="92" height="7" rx="3.5" fill="#15171b" opacity=".18" />
      <rect x="96" y="94" width="130" height="7" rx="3.5" fill="#15171b" opacity=".18" />
      <rect x="96" y="110" width="70" height="7" rx="3.5" fill="#15171b" opacity=".18" />
      <rect x="196" y="126" width="46" height="26" rx="6" fill={accent} opacity=".18" />
    </svg>
  )
}
{
  type === 'book' && (
    <svg viewBox="0 0 190 250" class="w-full drop-shadow-[0_30px_40px_rgba(0,0,0,0.2)]" aria-hidden="true">
      <rect width="190" height="250" rx="14" fill={accent} />
      <rect x="8" y="0" width="4" height="250" fill="#000" opacity=".12" />
      <circle cx="95" cy="108" r="36" fill="none" stroke="#e7c873" stroke-width="3" />
      <ellipse cx="95" cy="108" rx="16" ry="36" fill="none" stroke="#e7c873" stroke-width="2" />
      <path d="M59 108h72M64 90h62M64 126h62" stroke="#e7c873" stroke-width="2" />
      <text x="95" y="50" text-anchor="middle" fill="#e7c873" font-family="Instrument Serif, serif" font-size="22" letter-spacing="3">
        {label.toUpperCase()}
      </text>
      <text x="95" y="190" text-anchor="middle" fill="#e7c873" font-family="Plus Jakarta Sans Variable, sans-serif" font-size="10" font-weight="700" letter-spacing="3">
        INDONESIA
      </text>
      <rect x="70" y="206" width="50" height="14" rx="3" fill="none" stroke="#e7c873" stroke-width="1.5" />
    </svg>
  )
}
{
  type === 'form' && (
    <svg viewBox="0 0 200 250" class="w-full drop-shadow-[0_30px_40px_rgba(0,0,0,0.18)]" aria-hidden="true">
      <rect width="200" height="250" rx="12" fill="#fff" />
      <rect x="20" y="22" width="90" height="10" rx="5" fill="#15171b" opacity=".8" />
      <rect x="20" y="40" width="130" height="6" rx="3" fill="#15171b" opacity=".2" />
      {[70, 108, 146, 184].map((y, i) => (
        <g>
          <rect x="20" y={y} width="16" height="16" rx="4" fill={i < 2 ? accent : 'none'} stroke={accent} stroke-width="2" />
          {i < 2 && <path d={`M24 ${y + 8}l3 3 6-6`} stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />}
          <rect x="46" y={y + 2} width={100 - i * 12} height="6" rx="3" fill="#15171b" opacity=".6" />
          <rect x="46" y={y + 12} width={70 + i * 8} height="4" rx="2" fill="#15171b" opacity=".15" />
        </g>
      ))}
      <rect x="116" y="216" width="64" height="20" rx="10" fill={accent} />
    </svg>
  )
}
{
  type === 'receipt' && (
    <svg viewBox="0 0 190 250" class="w-full drop-shadow-[0_30px_40px_rgba(0,0,0,0.18)]" aria-hidden="true">
      <path d="M0 12a12 12 0 0 1 12-12h166a12 12 0 0 1 12 12v226l-12-8-12 8-12-8-12 8-12-8-12 8-12-8-12 8-12-8-12 8-12-8-12 8-12-8-12 8-12-8-12 8-12-8-10 8z" fill="#fff" />
      <circle cx="95" cy="40" r="16" fill={accent} opacity=".16" />
      <path d="M88 40l5 5 9-10" stroke={accent} stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <rect x="55" y="68" width="80" height="8" rx="4" fill="#15171b" opacity=".75" />
      {[96, 116, 136, 156].map((y) => (
        <g>
          <rect x="20" y={y} width="70" height="6" rx="3" fill="#15171b" opacity=".2" />
          <rect x="130" y={y} width="40" height="6" rx="3" fill="#15171b" opacity=".35" />
        </g>
      ))}
      <path d="M20 178h150" stroke="#15171b" stroke-opacity=".15" stroke-dasharray="4 4" />
      <rect x="20" y="192" width="50" height="8" rx="4" fill="#15171b" opacity=".6" />
      <rect x="110" y="190" width="60" height="12" rx="6" fill={accent} />
    </svg>
  )
}
