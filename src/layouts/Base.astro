---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Indonesia.gov — Halo, Indonesia',
  description = 'Konsep desain: satu pintu untuk semua layanan pemerintah Indonesia, dengan jawaban sederhana dari sumber resmi.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="overflow-x-clip">
    <slot />
    <script>
      import { smoothScroll, initScrollReveals } from '../scripts/motion';
      smoothScroll();
      initScrollReveals();
    </script>
  </body>
</html>
